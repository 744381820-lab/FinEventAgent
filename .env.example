# ============================================================
# 密钥与敏感项（仅此文件 / 云 Secrets；不要提交 .env）
# 其余业务与 LLM 参数统一在：demo/config/analysis.json
# ============================================================

# 大模型 API Key（base_url / model / 功能开关见 analysis.json → llm）
LLM_API_KEY=

# 进门 MCP Key（url / timeout 见 analysis.json → runtime）
JINMEN_MCP_KEY=

# 可选搜索 API（provider 见 analysis.json → sentiment.web_search_provider）
TAVILY_API_KEY=
BING_SEARCH_API_KEY=

# 可选覆盖（一般不需要；优先改 analysis.json）
# RUN_MODE=auto
# LLM_BASE_URL=
# LLM_MODEL=
# SEARCH_PROVIDER=bing_html

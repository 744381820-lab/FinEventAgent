{
  "name": "FinEventAgent",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r demo/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "FinEventAgent Web", "onAutoForward": "openBrowser" }
  },
  "postStartCommand": "PYTHONPATH=$PWD python run.py"
}
